<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================
         PARENT — inherits Spring Boot dependency management,
         plugin management, and sensible build defaults.
         ========================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <!-- =========================================================
         PROJECT COORDINATES
         ========================================================= -->
    <groupId>com.interviewiq</groupId>
    <artifactId>interviewiq-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>InterviewIQ Backend</name>
    <description>AI-powered interview platform backend — Spring Boot 3.3 / PostgreSQL 15</description>

    <!-- =========================================================
         PROPERTIES
         ========================================================= -->
    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>

        <!-- JaCoCo — code coverage (0.8.12 supports Java 21) -->
        <jacoco.version>0.8.12</jacoco.version>

        <!-- Newer Testcontainers than Spring Boot 3.3.6 manages (1.19.8), pulling a
             newer docker-java client for modern Docker Engine compatibility. -->
        <testcontainers.version>1.20.6</testcontainers.version>

        <!-- Docker Engine API version forced into the test JVM. Modern engines advertise
             a MinAPIVersion (e.g. 1.40 on Docker 29) and reject docker-java's default
             lower version with HTTP 400 ("Could not find a valid Docker environment").
             Pinning a value at/above that floor fixes it. Override per-environment with
             -Ddocker.api.version=X if your Docker is older than this. -->
        <docker.api.version>1.44</docker.api.version>

        <!-- AWS SDK v2 BOM version -->
        <aws.sdk.version>2.26.12</aws.sdk.version>

        <!-- JWT -->
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Apache Tika -->
        <tika.version>2.9.2</tika.version>

        <!-- Razorpay -->
        <razorpay.version>1.4.5</razorpay.version>

        <!-- Bucket4j — in-process token-bucket rate limiting -->
        <bucket4j.version>8.10.1</bucket4j.version>

        <!-- springdoc-openapi — Swagger UI auto-generation -->
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <!-- =========================================================
         DEPENDENCY MANAGEMENT — import BOMs for coordinated
         version management across AWS SDK v2 and Spring AI.
         ========================================================= -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring AI Bill of Materials -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- AWS SDK v2 Bill of Materials -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- =========================================================
         DEPENDENCIES
         ========================================================= -->
    <dependencies>

        <!-- ── Spring Boot Web ───────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Spring Security ───────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ── Spring Data JPA (Hibernate 6) ─────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── Bean Validation ───────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Actuator (health, metrics, info endpoints) ────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── AOP (AspectJ weaver + Spring AOP) ─────────────── -->
        <!--    Required for @Auditable / AuditAspect.            -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ── PostgreSQL JDBC Driver ────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Flyway Core ───────────────────────────────────── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ── Flyway PostgreSQL support (required for Flyway 10+) ── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ── Spring AI — OpenAI integration ───────────────── -->
        <!--    Spring AI 1.0.0 renamed starters: spring-ai-openai-spring-boot-starter
                → spring-ai-starter-model-openai.  API key is required at startup;
                set to a dummy value in local/test profiles via application-local.yml.  -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- ── Spring AI — Anthropic integration ────────────── -->
        <!--    Both starters are present because PRD v2.1 §9.1 makes vendor a
                per-workflow configuration value, not a build-time choice. The
                evaluation vendor is "undecided by design": §13.1 calls for
                shadow-running GPT-5.4-mini against Claude Haiku 4.5 over the
                first ~50 interviews and selecting on measured score-to-hire
                correlation. Both ChatModels implement ChatClient, so switching
                is a bean qualifier rather than a rewrite.                       -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!-- ── StringTemplate — prompt templates ────────────── -->
        <!--    PRD §7.5.1: "Prompts live as StringTemplate .st files under
                resources/prompts so they can be iterated without a code change."
                Chosen over string concatenation precisely because prompt
                iteration is expected to be frequent and shouldn't need a
                redeploy of compiled code to review a wording change.            -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>ST4</artifactId>
            <version>4.3.4</version>
        </dependency>

        <!-- ── WebSocket — the interview room's signalling channel ─── -->
        <!--    PRD v2.1 §7.5.2: one connection, eight events, carrying only text
                and control events. No media crosses it — getUserMedia,
                MediaRecorder, SpeechSynthesis and SpeechRecognition all run in
                the candidate's browser, and the 480p recording uploads
                browser-to-storage by pre-signed URL without touching this
                server. That is what makes one small pod capable of carrying
                dozens of simultaneous interviews.                              -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ── Micrometer Prometheus registry ───────────────── -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ── JWT: API + HMAC/RSA implementation ────────────── -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── AWS SDK v2: S3 ─────────────────────────────────── -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- ── AWS SDK v2: SES ────────────────────────────────── -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ses</artifactId>
        </dependency>

        <!-- Transcribe Streaming and Polly were removed with the March design:  -->
        <!-- speech-to-text and text-to-speech both run in the candidate's        -->
        <!-- browser via the Web Speech API (PRD v2.1 §7.5.2). No server-side     -->
        <!-- media processing exists anywhere in this application.                -->

        <!-- ── Apache Tika: document text extraction ─────────── -->
        <!--    tika-core: lightweight API + AutoDetectParser      -->
        <!--    tika-parsers-standard-package: PDF (PDFBox) +      -->
        <!--      DOCX (POI) + plain text parsers                   -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
            <!-- Exclude heavy optional parsers we don't need -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tika</groupId>
                    <artifactId>tika-parser-scientific-module</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.tika</groupId>
                    <artifactId>tika-parser-image-module</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.tika</groupId>
                    <artifactId>tika-parser-multimedia-module</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ── Razorpay Java SDK ─────────────────────────────── -->
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>${razorpay.version}</version>
        </dependency>

        <!-- ── Bucket4j — in-process rate limiting (no Redis required) ── -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- ── Google API Client — server-side ID token verification ───── -->
        <!--    Provides GoogleIdTokenVerifier, GoogleIdToken, NetHttpTransport,
                and GsonFactory used by GoogleOAuthService.                  -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- ── springdoc-openapi — Swagger UI at /swagger-ui.html ────── -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── Lombok ────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Test ──────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ── Testcontainers — real PostgreSQL for JPA integration tests ──────
             Versions are managed by the Spring Boot parent BOM (3.3.6). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =========================================================
         BUILD
         ========================================================= -->
    <build>
        <plugins>

            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final fat JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin — Java 21 + annotation processing for Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire — pass the pinned Docker API version to the test JVM as a system
                 property (docker-java reads `api.version`). Set via systemPropertyVariables,
                 not argLine, so it composes with the JaCoCo agent instead of clobbering it.
                 Harmless for unit tests (they never touch docker-java). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- JaCoCo — code coverage report from the unit-test (Surefire) run.
                 `prepare-agent` wires the coverage agent into Surefire's argLine;
                 `report` renders target/site/jacoco/index.html after the test phase.
                 Integration tests (*IT) are excluded from the default lifecycle, so
                 this report reflects unit coverage — run them separately for E2E numbers.
                 Generated/DTO-style classes are excluded so they don't dilute the metric. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/InterviewIqApplication.*</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/domain/**</exclude>
                        <exclude>**/config/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Coverage gate scoped to the NEW/rewritten INTIQ-6 code only.
                         Runs in `verify` (so `mvn test` stays report-only). Per-class
                         floors of 80% line + 80% branch — comfortably below the current
                         numbers (100/100, 100/100, 90/100) so routine edits don't break
                         the build, but the new logic can never silently regress untested.
                         WalletService is intentionally NOT gated: this ticket changed only
                         its Javadoc, and its Razorpay top-up paths predate these tests. -->
                    <execution>
                        <id>jacoco-check-new-code</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.interviewiq.session.scheduler.SessionExpiryJob</include>
                                        <include>com.interviewiq.session.service.SessionExpiryService</include>
                                        <include>com.interviewiq.billing.service.StrandedReservationCleanupRunner</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- =========================================================
         REPOSITORIES — needed for Spring AI milestones/snapshots
         if a non-GA build is required.
         ========================================================= -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>

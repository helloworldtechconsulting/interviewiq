<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  Logging configuration (PRD v2.1 §8)
  ============================================================================

  Until this file existed there was no logback configuration at all, so every
  deployed pod emitted Spring's default human-readable console pattern. That
  reads well over `kubectl logs` and is close to useless everywhere else: a
  stack trace spans many lines with no field structure, so nothing can group by
  request, filter by level, or correlate across the web and worker deployments.

  Two shapes, chosen by profile:

    staging, prod  → one JSON object per line, which is what every aggregator
                     expects.
    everything else → the existing pattern.

  Keyed on the deployed profiles by name rather than on "not local", so that a
  developer running with no profile set, and the integration tests running
  under the default profile, both get readable output. Naming the exception
  instead of the rule put JSON in front of anyone who had not explicitly asked
  for `local`.

  MDC is included wholesale so that traceId and spanId from Micrometer Tracing
  travel with each line without this file needing to know their names.
  ============================================================================
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="interviewiq"/>
    <springProperty scope="context" name="activeProfiles" source="spring.profiles.active" defaultValue="default"/>

    <!-- ── Local development: human-readable ──────────────────────────────── -->
    <springProfile name="!staging &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ── Deployed: one JSON object per line ─────────────────────────────── -->
    <springProfile name="staging | prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <version/>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <message/>

                    <!-- traceId / spanId arrive here from Micrometer Tracing.
                         Taking the whole MDC rather than named fields means a
                         new correlation key starts appearing in logs the moment
                         something puts it in the MDC. -->
                    <mdc/>

                    <!-- Which deployment produced the line. web and worker run
                         the same image, so without this the two are
                         indistinguishable in an aggregated view — and "did the
                         worker see this?" is the first question in most
                         pipeline incidents. -->
                    <pattern>
                        <pattern>
                            {
                              "service": "${appName}",
                              "profile": "${activeProfiles}",
                              "pod": "${HOSTNAME:-unknown}"
                            }
                        </pattern>
                    </pattern>

                    <!-- Exceptions as one field rather than many lines: a stack
                         trace split across lines loses its association with the
                         message that caused it. -->
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>40</maxDepthPerThrowable>
                            <maxLength>8192</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>

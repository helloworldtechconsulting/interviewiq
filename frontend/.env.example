# InterviewIQ Frontend — environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. .env.example is committed.

# Base URL of the Spring Boot API (leave empty when using Vite proxy in dev)
VITE_API_BASE_URL=

# Company slug used in all auth API paths: /api/v1/{slug}/auth/*
# Must match the company slug in the database (seed: interviewiq-dev, prod: your company slug)
VITE_COMPANY_SLUG=interviewiq-dev

# Razorpay publishable key (loaded dynamically — only needed at runtime via backend response)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

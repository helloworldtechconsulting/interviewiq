# =============================================================================
# InterviewEngine Frontend — environment variables
#
#   cp .env.example .env.local
#
# .env.local is git-ignored (*.local in frontend/.gitignore). .env.example is
# committed.
#
# EVERY value here is BUILD-time. Vite inlines VITE_* into the bundle when
# `npm run build` runs — there is no runtime override. Changing one means
# rebuilding, not restarting.
#
# For the Docker image these same values are passed as --build-arg (see
# frontend/Dockerfile and the `frontend.build.args` block in the root
# docker-compose.yml), NOT as container environment variables.
# =============================================================================

# Base URL of the Spring Boot API.
# Leave empty in dev (Vite proxies /api) and in the Docker image (Nginx proxies
# /api to the app container on the same origin). Set it only when the SPA is
# served from a different origin than the API — e.g. an S3/CloudFront build
# pointing at https://api.interviewengine.ai
VITE_API_BASE_URL=

# Company slug used in every auth API path: /api/v1/{slug}/auth/*
# Must match a company slug in the database.
#   local seed data  → interviewengine-dev
#   production       → your real company slug
# A wrong value authenticates against the wrong tenant with no visible error.
VITE_COMPANY_SLUG=interviewengine-dev

# Google OAuth 2.0 Client ID (Google Cloud Console → Credentials).
# Leave blank to hide the Google sign-in button. The backend must be given the
# matching APP_SECURITY_GOOGLE_CLIENT_ID or the ID token will be rejected.
VITE_GOOGLE_CLIENT_ID=

# NOTE: the Razorpay publishable key is deliberately NOT here. It is returned
# by the backend in the create-order response and read at runtime, so it never
# needs to be baked into the bundle.

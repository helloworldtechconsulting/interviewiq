# =============================================================================
# .env.example — InterviewEngine
#
#   cp .env.example .env      # project root — docker compose reads it automatically
#
# NEVER commit .env (.gitignore already covers .env and .env.*).
#
# WHO READS THIS FILE
#   - `docker compose` (root .env) — substitutes ${VAR} in docker-compose.yml
#   - Spring Boot does NOT read .env. Running from the IDE/Maven, either use the
#     `local` profile (self-contained, no env vars needed) or export first:
#         set -a; source .env; set +a
#         ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#   - Vite reads frontend/.env.local, not this file. See frontend/.env.example.
#
# Sections
#   0. Runtime profile      5. Payments (Razorpay)
#   1. Database             6. Object storage (S3-compatible)
#   2. Security             7. Email (SMTP + bounce webhook)
#   3. URLs / CORS          8. Observability (optional)
#   4. AI providers         9. Host port bindings (compose only)
#  10. Optional overrides
# =============================================================================


# =============================================================================
# 0. RUNTIME PROFILE
# =============================================================================
# local | staging | prod, optionally plus the deployment half: web | worker.
#   prod,web     → REST + WebSocket, schedulers OFF   (min 2 replicas)
#   prod,worker  → schedulers ON, serves no traffic   (min 1 replica)
# A single-process run (just "prod") enables everything.
SPRING_PROFILES_ACTIVE=prod,web


# =============================================================================
# 1. DATABASE                                    (all REQUIRED in staging/prod)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=interviewengine
DB_USERNAME=interviewengine
DB_PASSWORD=change_me


# =============================================================================
# 2. SECURITY — JWT + INVITE TOKENS              (all REQUIRED in staging/prod)
# =============================================================================
# RSA 2048 private key, PKCS#8 PEM. Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Flatten to one line with literal \n before putting it in an env var:
#   awk 'NF{printf "%s\\n",$0}' private.pem
# If blank, TokenConfig generates a throwaway pair on every boot and every
# restart invalidates all access tokens.
APP_SECURITY_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANB...\n-----END PRIVATE KEY-----
APP_SECURITY_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----

# HMAC-SHA256 secret for candidate invite links. Min 32 chars.
#   openssl rand -base64 32
# If blank, every deploy kills all outstanding invite links.
APP_SECURITY_INVITE_SECRET=replace_with_32_plus_char_random_secret


# =============================================================================
# 3. URLS / CORS                                 (all REQUIRED in staging/prod)
# =============================================================================
# Comma-separated exact origins. No wildcard fallback exists — an unlisted
# origin is refused and the SPA cannot call the API.
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://app.interviewengine.ai

# Public frontend base URL, no trailing slash. Every emailed link (invite,
# booking confirmation, password reset) is built from this. A wrong value
# silently emails dead links; unset falls back to http://localhost:3000.
APP_FRONTEND_BASE_URL=https://app.interviewengine.ai


# =============================================================================
# 4. AI PROVIDERS                                (both REQUIRED in staging/prod)
# =============================================================================
# Both starters are on the classpath and both need a key at startup — vendor is
# per-workflow config (app.ai.*), not a build-time choice.
#   question / followup → OpenAI      evaluation → Anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# The cheap-provider escape hatch. Most low-cost providers speak the OpenAI wire
# protocol (DeepSeek, Groq, Together, Fireworks, OpenRouter, local Ollama/vLLM),
# so repointing the base URL moves every OpenAI-shaped workflow across with no
# code change — set the key and the model IDs to match:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_API_KEY=<their key>
#   APP_AI_QUESTION_MODEL=deepseek-chat
# Distinct from app.ai.*.vendor, which switches between starters whose protocols
# genuinely differ. Caveat: PRD §10 keeps candidate data in India — a compatible
# protocol does not make the inference jurisdiction acceptable.
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com


# =============================================================================
# 5. PAYMENTS — RAZORPAY                         (both REQUIRED in staging/prod)
# =============================================================================
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# =============================================================================
# 6. OBJECT STORAGE — S3-compatible
# =============================================================================
# One SDK + an endpoint override runs on S3, R2, GCS interop, Spaces or MinIO.
OBJECT_STORAGE_BUCKET=interviewengine-prod            # REQUIRED
OBJECT_STORAGE_REGION=ap-south-1                  # R2 expects "auto"
OBJECT_STORAGE_ENDPOINT=                          # empty = real AWS S3
# Leave both blank on AWS with an IAM role attached (default credential chain).
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=


# =============================================================================
# 7. EMAIL
# =============================================================================
# SMTP transport — Resend / Brevo / Postmark / SES-over-SMTP. REQUIRED in
# staging/prod; STARTTLS is required, port 465 implicit TLS will not work.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_...

MAIL_FROM_ADDRESS=noreply@interviewengine.ai          # REQUIRED; domain must have DKIM+SPF+DMARC
MAIL_FROM_NAME=InterviewEngine

# Bounce / complaint callbacks. Both blank on purpose — the endpoint rejects
# rather than guessing. Blank means bounces are accepted with HTTP 200 and
# silently ignored: no suppression, no log line.
MAIL_WEBHOOK_PROVIDER=                            # resend | postmark | brevo
MAIL_WEBHOOK_SECRET=
MAIL_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature


# =============================================================================
# 8. OBSERVABILITY (optional)
# =============================================================================
# 0.0 = traceId/spanId still land in the JSON logs, nothing is exported.
# Raising this with no collector behind OTLP_ENDPOINT logs an export failure
# on every retry.
TRACING_SAMPLE_RATE=0.0
OTLP_ENDPOINT=http://localhost:4318/v1/traces


# =============================================================================
# 9. HOST PORT BINDINGS — docker compose only, not read by the app
# =============================================================================
DB_PORT_EXPOSED=5432
APP_PORT=8080
FRONTEND_PORT=3000


# =============================================================================
# 10. OPTIONAL OVERRIDES
# -----------------------------------------------------------------------------
# Not templated in the YAML, but Spring's relaxed binding maps SCREAMING_SNAKE
# env vars onto any app.* property, so these work without a code change.
# =============================================================================
# APP_SECURITY_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# APP_BILLING_SESSION_COST_PAISE=10000        # default ₹100 per completed interview
# APP_BILLING_MINIMUM_TOP_UP_PAISE=10000
# APP_BILLING_SIGNUP_GRANT_ENABLED=true
# APP_BILLING_STRAND_CLEANUP_ENABLED=false    # one deploy only, then back to false
# APP_AI_EVALUATION_VENDOR=anthropic
# APP_AI_EVALUATION_MODEL=claude-haiku-4-5
# APP_AI_SHADOW_EVALUATION=false
# APP_SCHEDULING_BUCKET_CAPACITY=25
# APP_STORAGE_RECORDING_RETENTION_DAYS=7
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

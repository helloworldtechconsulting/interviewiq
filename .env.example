# =============================================================================
# .env.example — InterviewIQ Environment Variables
#
# Copy this file to .env and fill in every value before running docker compose.
#
#   cp .env.example .env
#
# NEVER commit .env to source control — it contains production secrets.
# .env is already listed in .gitignore.
#
# Sections:
#   1. Database
#   2. Security (JWT + invite tokens)
#   3. OpenAI
#   4. Razorpay
#   5. AWS
#   6. Application
# =============================================================================


# =============================================================================
# 1. DATABASE
# =============================================================================

# Postgres database name (used by both the postgres container and the app)
DB_NAME=interviewiq

# Postgres user + password
# These are passed to both POSTGRES_USER/POSTGRES_PASSWORD (container init)
# and to the Spring datasource (app login).
DB_USERNAME=interviewiq
DB_PASSWORD=change_me_in_production

# Host port that Postgres binds to on the Docker host.
# The app always connects to the internal compose port (5432); this only
# affects external tooling (e.g. TablePlus, psql from your laptop).
DB_PORT_EXPOSED=5432


# =============================================================================
# 2. SECURITY — JWT + INVITE TOKENS
# =============================================================================

# RSA 2048-bit private key in PKCS#8 PEM format.
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     | openssl pkcs8 -topk8 -nocrypt -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#
# For Docker/env-var injection, the PEM must be on a single line with
# literal \n characters replacing real newlines:
#   awk 'NF{printf "%s\\n",$0}' private.pem
APP_SECURITY_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANB...\n-----END PRIVATE KEY-----

# RSA public key in SPKI PEM format (paired with the private key above).
APP_SECURITY_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----

# HMAC-SHA256 secret for candidate invite tokens.
# Minimum 32 characters. Use a cryptographically random value:
#   openssl rand -base64 32
APP_SECURITY_INVITE_SECRET=replace_with_32_plus_char_random_secret


# =============================================================================
# 3. OPENAI
# =============================================================================

# OpenAI API key — used for question generation and evaluation.
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# =============================================================================
# 4. RAZORPAY
# =============================================================================

# Razorpay API credentials — used to create payment orders and verify webhooks.
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# =============================================================================
# 5. AWS
# =============================================================================

# AWS region where S3 bucket and SES are configured.
# ap-south-1 = Mumbai (recommended for Indian SMB latency)
AWS_REGION=ap-south-1

# S3 bucket name for JD files and candidate resumes.
# Must exist before starting the application.
AWS_S3_BUCKET=your-interviewiq-bucket

# IAM credentials for the app's AWS SDK calls (S3 + SES).
# In production on EC2/ECS, prefer an IAM Role attached to the instance/task
# instead of static credentials — set both to empty string and remove from here.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key


# =============================================================================
# 6. APPLICATION
# =============================================================================

# Public base URL of the frontend — used in candidate invite email links.
# No trailing slash.
APP_FRONTEND_BASE_URL=https://app.interviewiq.ai

# Cost per interview session in paise (100 paise = ₹1).
# Default: 5000 paise = ₹50. Override here to change pricing per deployment.
APP_BILLING_SESSION_COST_PAISE=5000

# Host port the Spring Boot app listens on (Docker host binding).
APP_PORT=8080

# Host port the React frontend (Nginx) listens on (Docker host binding).
FRONTEND_PORT=3000
